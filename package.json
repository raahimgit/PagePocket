{
  "name": "contextlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first research capture for developers. Local-only, source-preserving.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs chrome && node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev": "node scripts/build.mjs chrome --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build && node e2e/run-all.cjs",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir dist/firefox",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node scripts/package.mjs",
    "package:chrome": "node scripts/package.mjs chrome",
    "package:firefox": "node scripts/package.mjs firefox",
    "package:source": "node scripts/package.mjs source",
    "screenshots": "npm run build && node e2e/screenshots.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
